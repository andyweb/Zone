{
  "expo": {
    "name": "Segnalazioni Live",
    "slug": "segnalazioni-live",
    "version": "1.0.0",
    "scheme": "segnalazioni",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "L'app usa la tua posizione per mostrarti le segnalazioni vicine e per crearne di nuove nel punto in cui ti trovi."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "L'app usa la tua posizione per mostrarti le segnalazioni vicine."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
