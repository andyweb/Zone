# Copia in .env e personalizza. NON committare .env (è in .gitignore).

# --- Database ---
# Dentro docker-compose l'host è il servizio "db".
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/segnalazioni

# Credenziali usate dal container Postgres (devono combaciare con DATABASE_URL).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=segnalazioni

# --- Auth / JWT ---
# OBBLIGATORIO cambiarlo. Genera con: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_genera_un_secret_robusto
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=1440

# --- App ---
DEBUG=false

# --- Push (dietro flag, sezione 5.3) ---
PUSH_ENABLED=false
# Raggio (m) entro cui notificare gli utenti con posizione recente.
PUSH_RADIUS_M=1500

# --- Ruoli / accreditamento (verticale Protezione Civile) ---
# Codici distribuiti dall'ente per accreditare in registrazione. Se vuoti,
# nessuno può ottenere quel ruolo (tutti restano "cittadino").
ENROLLMENT_CODE_VOLONTARIO=
ENROLLMENT_CODE_OPERATORE=
# Peso di reputazione iniziale per ruolo (pesa i voti / il TTL).
TRUST_CITTADINO=1.0
TRUST_VOLONTARIO=2.0
TRUST_OPERATORE=3.0

# --- Moderazione (sezione 8) ---
# Filtro blocklist sul testo delle note (true=attivo). La blocklist vive in
# app/moderation.py ed è un placeholder da curare prima del rilascio.
MODERATION_ENABLED=true
# Numero di segnalazioni-abuso distinte oltre cui una segnalazione è auto-rimossa.
MODERATION_FLAG_THRESHOLD=3

# --- Retention / GDPR (sezione 8) ---
# Dopo questa finestra le segnalazioni scadute/rimosse vengono cancellate.
RETENTION_DELETE_AFTER_MINUTES=1440
RETENTION_JOB_INTERVAL_MINUTES=60
